---
import Base from '../layouts/Base.astro';
import { orgs, meta, hasLiveData, fmtDate } from '../lib/data';
import { allEvents } from '../lib/calendar';
import { SITE_NAME, SITE_TAGLINE } from '../config';
import { icons } from '../lib/icons';
const today = new Date().toISOString().slice(0, 10);
const next = allEvents().filter((e) => (e.end ?? e.start) >= today).slice(0, 5);
const featured = orgs.filter((o) => o.years.hasOwnProperty('2026')).sort((a, b) => b.years_count - a.years_count || a.name.localeCompare(b.name)).slice(0, 8);
const langs = ['Python', 'JavaScript', 'TypeScript', 'Rust', 'Go', 'C++', 'Java', 'C'];
const I = icons;
---
<Base title={SITE_NAME} description={`${SITE_TAGLINE} Free, no login, with every GSoC mentoring organization since 2016 linked to live GitHub issues, and one calendar for GSoC, Outreachy, LFX and more.`} wide crumb="Home" crumbDesc={SITE_TAGLINE}>
  <form class="toolbar" action="/issues/" method="get" role="search">
    <div class="searchbar">
      <label class="field"><Fragment set:html={I.search} /><span class="sr-only">Search issues</span><input type="search" name="q" placeholder="Search open-source issues by title or repository" autocomplete="off" /></label>
      <div class="aux"><button class="btn" type="submit">Search</button></div>
    </div>
    <div class="pills">
      <span class="muted small">Browse by language:</span>
      <span class="lang-chips">{langs.map((l) => <a href={`/issues/?lang=${encodeURIComponent(l.toLowerCase())}`} aria-label={`${l} issues`}>{l}</a>)}<a href="/issues/">All issues</a></span>
    </div>
  </form>

  {hasLiveData ? (
    <div class="stats">
      <div><strong>{meta.counts.open.toLocaleString()}</strong>open right now</div>
      <div><strong>{meta.counts.repos.toLocaleString()}</strong>repositories</div>
      <div><strong>{meta.counts.orgs_with_issues}</strong>GSoC orgs with live issues</div>
      <div><strong>{meta.eval.done && meta.eval.precision_claimed != null ? `${Math.round(meta.eval.precision_claimed * 100)}%` : 'not yet'}</strong>measured precision</div>
      <div><strong>{fmtDate(meta.generated_at)}</strong>last refresh</div>
    </div>
  ) : (
    <p class="notice small">Live issues appear after the first data run. GSoC organizations, the calendar and the guides are ready now.</p>
  )}

  <div class="section-head"><h2>GSoC 2026 organizations with the longest track record</h2><a href="/gsoc/">All {orgs.length} organizations →</a></div>
  <div class="grid">
    {featured.map((o) => {
      const ys = Object.keys(o.years).map(Number); const first = Math.min(...ys), last = Math.max(...ys);
      const initials = o.name.replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
      return (
        <article class="card item">
          <div class="head">
            <div class="logo">{o.github_orgs[0] && <img src={`https://github.com/${o.github_orgs[0]}.png?size=88`} alt="" loading="lazy" width="44" height="44" onerror="this.remove()" />}{initials}</div>
            <div class="ttl"><h2><a href={`/gsoc/${o.slug}/`}>{o.name}</a></h2><div class="sub">{o.category}</div></div>
          </div>
          <div class="rows">
            <div><Fragment set:html={I.calendar} /><span>{ys.length} years · {first}–{last}</span></div>
            <div><Fragment set:html={I.users} /><span>{o.total_projects} projects total</span></div>
          </div>
          <div class="chips">{o.technologies.slice(0, 4).map((t) => <span>{t}</span>)}</div>
          <div class="foot"><span>{o.github_orgs[0] ? `github.com/${o.github_orgs[0]}` : 'No GitHub org mapped'}</span><span class="new">In GSoC 2026</span></div>
        </article>
      );
    })}
  </div>

  <div class="two">
    <section>
      <div class="section-head"><h2>Upcoming deadlines</h2><a href="/calendar/">Calendar &amp; ICS →</a></div>
      <ul class="timeline compact">{next.map((e) => <li class={e.start <= today ? 'now' : ''}><span class="when">{e.end ? `${e.start} → ${e.end}` : e.start}</span><span>{e.program.short}: {e.title.replace(/\s*\(.*$/, '')} {e.status !== 'verified' && <span class="badge warn plain">{e.status}</span>}</span></li>)}</ul>
    </section>
    <section>
      <div class="section-head"><h2>How a verdict is made</h2><a href="/methodology/">Methodology →</a></div>
      <div class="card">
        <p style="margin-top:0">For every issue we look at assignees, linked and cross-referenced pull requests, and the last ten comments.</p>
        <p><span class="badge ok">Open</span> none of the signals below.<br /><span class="badge bad">Claimed</span> assignee, open linked PR, or a claim comment with no maintainer rebuttal.<br /><span class="badge warn">Stale claim</span> claim with no PR and no activity for 14 days.<br /><span class="badge info">Restricted</span> repo forbids AI on these issues or limits first-time PRs.</p>
        <p class="small muted" style="margin-bottom:0">We never comment, assign or ping anyone. You claim the issue on GitHub, following the project's own rules.</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 0 1.5rem; }
</style>
